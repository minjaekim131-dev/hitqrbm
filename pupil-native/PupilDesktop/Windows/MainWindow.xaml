<Window x:Class="PupilDesktop.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pupil Desktop" Width="1320" Height="900" MinWidth="900" MinHeight="620"
        WindowStartupLocation="CenterScreen">
  <DockPanel>
    <Border DockPanel.Dock="Top" Padding="10" BorderBrush="#22000000" BorderThickness="0,0,0,1">
      <StackPanel>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <TextBox x:Name="SearchBox" Grid.Column="0" FontSize="15" KeyDown="SearchBox_KeyDown"
                   ToolTip="예: artist:name  female:tag  language:korean  -male:tag"/>
          <Button Grid.Column="1" Content="검색" Click="Search_Click"/>
          <ComboBox x:Name="SortBox" Grid.Column="2" Width="150" SelectionChanged="SortBox_SelectionChanged"/>
          <Button x:Name="FavoritesButton" Grid.Column="3" Content="★ 즐겨찾기" Click="Favorites_Click"/>
          <CheckBox x:Name="StartupFavoritesCheck" Grid.Column="4" Margin="10,0" VerticalAlignment="Center"
                    Content="시작 시 즐겨찾기" Checked="StartupFavoritesCheck_Changed" Unchecked="StartupFavoritesCheck_Changed"/>
          <Button Grid.Column="5" Content="ID로 열기" Click="OpenId_Click"/>
        </Grid>

        <Border Margin="0,8,0,0" Padding="8" BorderBrush="#22000000" BorderThickness="1" CornerRadius="4">
          <StackPanel>
            <WrapPanel VerticalAlignment="Center">
              <TextBlock Text="유형" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0"/>
              <CheckBox x:Name="DoujinshiCheck" Content="동인지" IsChecked="True" Margin="0,0,10,0"
                        Checked="Filter_Changed" Unchecked="Filter_Changed"/>
              <CheckBox x:Name="MangaCheck" Content="만화" IsChecked="True" Margin="0,0,10,0"
                        Checked="Filter_Changed" Unchecked="Filter_Changed"/>
              <CheckBox x:Name="ArtistCgCheck" Content="Artist CG" IsChecked="True" Margin="0,0,10,0"
                        Checked="Filter_Changed" Unchecked="Filter_Changed"/>
              <CheckBox x:Name="GameCgCheck" Content="Game CG" IsChecked="True" Margin="0,0,10,0"
                        Checked="Filter_Changed" Unchecked="Filter_Changed"/>
              <CheckBox x:Name="ImageSetCheck" Content="Image Set" IsChecked="True" Margin="0,0,10,0"
                        Checked="Filter_Changed" Unchecked="Filter_Changed"/>
              <CheckBox x:Name="AnimeCheck" Content="Anime" IsChecked="True" Margin="0,0,18,0"
                        Checked="Filter_Changed" Unchecked="Filter_Changed"/>

              <TextBlock Text="언어" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,6,0"/>
              <ComboBox x:Name="LanguageBox" Width="125" SelectionChanged="Filter_Changed"/>
              <Button Content="필터 초기화" Margin="8,0,0,0" Click="ResetFilters_Click"/>
            </WrapPanel>

            <Grid Margin="0,8,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>

              <TextBlock Grid.Column="0" Text="포함 태그" FontWeight="SemiBold" VerticalAlignment="Top" Margin="0,4,6,0"/>
              <StackPanel Grid.Column="1">
                <TextBox x:Name="IncludeTagInput" TextChanged="IncludeTagInput_TextChanged" KeyDown="IncludeTagInput_KeyDown"
                         ToolTip="태그 앞부분을 입력하면 자동완성됩니다. 예: big 또는 female:big"/>
                <ListBox x:Name="IncludeSuggestionList" MaxHeight="130" Visibility="Collapsed"
                         SelectionChanged="IncludeSuggestionList_SelectionChanged"/>
                <WrapPanel x:Name="IncludeTagChips" Margin="0,4,0,0"/>
                <TextBox x:Name="IncludeTagsBox" Visibility="Collapsed" TextChanged="StoredTags_TextChanged"/>
              </StackPanel>

              <TextBlock Grid.Column="2" Text="제외 태그" FontWeight="SemiBold" VerticalAlignment="Top" Margin="12,4,6,0"/>
              <StackPanel Grid.Column="3">
                <TextBox x:Name="ExcludeTagInput" TextChanged="ExcludeTagInput_TextChanged" KeyDown="ExcludeTagInput_KeyDown"
                         ToolTip="제외할 태그를 여러 개 선택할 수 있습니다."/>
                <ListBox x:Name="ExcludeSuggestionList" MaxHeight="130" Visibility="Collapsed"
                         SelectionChanged="ExcludeSuggestionList_SelectionChanged"/>
                <WrapPanel x:Name="ExcludeTagChips" Margin="0,4,0,0"/>
                <TextBox x:Name="ExcludeTagsBox" Visibility="Collapsed" TextChanged="StoredTags_TextChanged"/>
              </StackPanel>

              <Button Grid.Column="4" Content="필터 적용" Margin="8,0,0,0" VerticalAlignment="Top" Click="ApplyFilters_Click"/>
            </Grid>
          </StackPanel>
        </Border>
      </StackPanel>
    </Border>

    <Border DockPanel.Dock="Bottom" Padding="8" BorderBrush="#22000000" BorderThickness="0,1,0,0">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
        <TextBlock x:Name="StatusText" VerticalAlignment="Center" Foreground="#777"/>
        <StackPanel Grid.Column="1" Orientation="Horizontal">
          <Button Content="◀ 이전" Click="Prev_Click"/>
          <TextBlock x:Name="PageText" VerticalAlignment="Center" Margin="10,0"/>
          <Button Content="다음 ▶" Click="Next_Click"/>
        </StackPanel>
      </Grid>
    </Border>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <WrapPanel x:Name="GalleryPanel" Margin="10" ItemWidth="230"/>
    </ScrollViewer>
  </DockPanel>
</Window>
