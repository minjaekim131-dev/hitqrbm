<Window x:Class="PupilDesktop.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pupil Desktop" Width="1260" Height="820" MinWidth="800" MinHeight="560"
        WindowStartupLocation="CenterScreen">
  <DockPanel>
    <Border DockPanel.Dock="Top" Padding="10" BorderBrush="#22000000" BorderThickness="0,0,0,1">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <TextBox x:Name="SearchBox" Grid.Column="0" FontSize="15" KeyDown="SearchBox_KeyDown"
                 ToolTip="예: artist:name  female:tag  language:korean  -male:tag"/>
        <Button Grid.Column="1" Content="검색" Click="Search_Click"/>
        <ComboBox x:Name="SortBox" Grid.Column="2" Width="150" SelectionChanged="SortBox_SelectionChanged"/>
        <Button Grid.Column="3" Content="ID로 열기" Click="OpenId_Click"/>
      </Grid>
    </Border>

    <Border DockPanel.Dock="Bottom" Padding="8" BorderBrush="#22000000" BorderThickness="0,1,0,0">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
        <TextBlock x:Name="StatusText" VerticalAlignment="Center" Foreground="#777"/>
        <StackPanel Grid.Column="1" Orientation="Horizontal">
          <Button Content="◀ 이전" Click="Prev_Click"/>
          <TextBlock x:Name="PageText" VerticalAlignment="Center" Margin="10,0"/>
          <Button Content="다음 ▶" Click="Next_Click"/>
        </StackPanel>
      </Grid>
    </Border>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <WrapPanel x:Name="GalleryPanel" Margin="10" ItemWidth="230"/>
    </ScrollViewer>
  </DockPanel>
</Window>
