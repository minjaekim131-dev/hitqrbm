<Window x:Class="PupilDesktop.Windows.ReaderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="1050" Height="900" MinWidth="620" MinHeight="500"
        Background="#111" Foreground="White" WindowStartupLocation="CenterOwner"
        KeyDown="Window_KeyDown" PreviewMouseWheel="Window_PreviewMouseWheel">
  <DockPanel>
    <Border DockPanel.Dock="Top" Background="#222" Padding="8">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock x:Name="TitleText" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
          <TextBlock x:Name="MetaText" Foreground="#AAA" FontSize="11"/>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal">
          <Button Content="현재 페이지 저장" Click="SavePage_Click"/>
          <Button Content="전체 저장" Click="SaveAll_Click"/>
        </StackPanel>
      </Grid>
    </Border>
    <Border DockPanel.Dock="Bottom" Background="#222" Padding="6">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
        <Button HorizontalAlignment="Right" Content="◀ 이전" Click="Prev_Click"/>
        <TextBlock Grid.Column="1" x:Name="PageText" VerticalAlignment="Center" Margin="14,0"/>
        <Button Grid.Column="2" HorizontalAlignment="Left" Content="다음 ▶" Click="Next_Click"/>
      </Grid>
    </Border>
    <Grid>
      <ScrollViewer x:Name="ImageScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
        <Image x:Name="PageImage" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </ScrollViewer>
      <TextBlock x:Name="LoadingText" Text="불러오는 중…" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Grid>
  </DockPanel>
</Window>
